# main.py - TRANSMISOR NRF24L01
from machine import Pin, SPI, I2C
import time
import ssd1306
from nrf24 import NRF24, RATES, POWER_DBM

# Parámetros de radio
RF_CHANNEL = 40
RF_POWER = 3
RF_RATE = 1
STEP = 4
ACK = True
DATA_SIZE = 28

TEXTS = (
    "Luis L",
    "Stefany C",
    "LUISCARLOSEMUSPINZON",
    "STEFANYJULIANACACERESMOGOLLON",
    "LUISCARLOSEMUSPINZON:3STEFANYJULIANACACERESMOGOLLON",
)

# OLED, SPI y NRF24
display_bus = I2C(0, sda=Pin(4), scl=Pin(5), freq=400000)
screen = ssd1306.SSD1306_I2C(128, 64, display_bus)

radio_spi = SPI(
    0, baudrate=1_000_000, polarity=0, phase=0,
    sck=Pin(18), mosi=Pin(19), miso=Pin(16)
)

rf = NRF24(
    radio_spi,
    csn=17,
    ce=20,
    channel=RF_CHANNEL,
    power=RF_POWER,
    rate=RF_RATE,
    auto_ack=ACK
)

key_channel = Pin(10, Pin.IN, Pin.PULL_UP)
key_power = Pin(11, Pin.IN, Pin.PULL_UP)
key_send = Pin(12, Pin.IN, Pin.PULL_UP)

led_good = Pin(21, Pin.OUT)
led_bad = Pin(22, Pin.OUT)

current = 0


def was_pressed(button):
    if button.value() != 0:
        return False

    time.sleep_ms(30)

    if button.value() != 0:
        return False

    while button.value() == 0:
        time.sleep_ms(10)

    return True


def display_state(message=""):
    screen.fill(0)
    screen.text("TX CH %d" % rf.channel, 0, 0)
    screen.text("%d MHz" % rf.freq_mhz, 0, 10)
    screen.text("%s %d dBm" %
                (RATES[rf.rate], POWER_DBM[rf.power]), 0, 20)
    screen.text("Msg %d/%d" %
                (current + 1, len(TEXTS)), 0, 30)
    screen.text(TEXTS[current][:16], 0, 40)
    screen.text(message, 0, 50)
    screen.show()


def transmit(number):
    raw = TEXTS[number].encode()

    pieces = [
        raw[pos:pos + DATA_SIZE]
        for pos in range(0, len(raw), DATA_SIZE)
    ]

    if not pieces:
        pieces = [b""]

    count = len(pieces)

    for sequence, part in enumerate(pieces):
        packet = bytes(
            (number, sequence, count, len(part))
        ) + part

        if not rf.send(packet):
            return False

    return True


screen.fill(0)
screen.text("Lab Comunicacion", 0, 8)
screen.text("Digital Inalamb.", 0, 20)
screen.text("GFSK - NRF24L01", 0, 32)
screen.text("Transmisor", 0, 48)
screen.show()

print(
    "Transmisor listo | canal",
    rf.channel,
    "|",
    RATES[rf.rate],
    "|",
    POWER_DBM[rf.power],
    "dBm"
)

time.sleep(2)
display_state("Listo")


while True:

    if was_pressed(key_channel):
        new_channel = (rf.channel + STEP) % 126
        value = rf.set_channel(new_channel)

        print("RF_CH =", value)
        display_state("Canal cambiado")

    if was_pressed(key_power):
        value = rf.set_power((rf.power + 1) & 3)

        print("RF_SETUP = 0x%02X" % value)
        display_state("Potencia cambiada")

    if was_pressed(key_send):
        display_state("Enviando...")

        success = transmit(current)

        if success:
            led_good.on()
        else:
            led_bad.on()

        time.sleep_ms(300)

        led_good.off()
        led_bad.off()

        print(
            "Msg",
            current,
            "OK" if success else "FALLO"
        )

        display_state(
            "Enviado OK" if success else "FALLO"
        )

        current = (current + 1) % len(TEXTS)

    time.sleep_ms(10)
